# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is tracked: the workspace ships binaries (flux-ctl, flux-profiler) and
# releases build with --locked so a tagged version always resolves the same deps.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by Intellij-based IDEs.
.idea

# Generated by MacOS
.DS_Store

# Generated test-vectors for DB
testdata/micro/db

# Generated data for stage benchmarks
crates/stages/testdata


# Proptest data
proptest-regressions/

# Release artifacts
dist/

# Database debugging tools
db-tools/

# VSCode
.vscode

# Pi coding agent config (ask @louisponet for a .pi folder)
.pi

# Coverage report
lcov.info

# Python bytecode from .github/scripts
__pycache__/
*.pyc
